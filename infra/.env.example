# Optional Docker Compose environment file.
# Copy to infra/.env. This Compose stack uses the configured cloud PostgreSQL/PostGIS;
# it does not start PostgreSQL, Redis, MinIO, or other services.

ENVIRONMENT=development
BACKEND_PORT=8000
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DATABASE?sslmode=require
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters
CORS_ORIGINS=http://localhost:3000
