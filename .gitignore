# ==============================================================================
# AgroSight Root .gitignore
# ==============================================================================

# --- Operating System & Editor Files ---
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/
*.sublime-project
*.sublime-workspace

# --- Environment and Secret Files ---
.env
.env.*
.envrc
!.env.example
*.local

# --- Python & Virtual Environments ---
__pycache__/
*.py[codz]
*$py.class
*.so
.Python
.venv/
env/
venv/
ENV/
env.bak/
venv.bak/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
.pdm-python
.pdm-build/
.pixi/
!.pixi/config.toml
__pypackages__/

# --- Python Testing, Coverage & Linters ---
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py.cover
*.lcov
.hypothesis/
.pytest_cache/
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/
.pyre/
.pytype/
cython_debug/

# --- Node.js & Frontend Web ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-store/
.vite/
apps/frontend/web/dist/
apps/frontend/web/dist-ssr/
dist/
dist-ssr/
*.tsbuildinfo
.next/
out/

# --- Geospatial Data, Rasters & Local Storage ---
storage/*
!storage/.gitkeep
apps/backend/storage/*
!apps/backend/storage/.gitkeep
*.tif
*.tiff
*.cog
*.geotiff
*.h5
*.nc
*.nc4
*.gpkg
*.geojson.cache

# --- Docker & Logs ---
*.log
docker-compose.override.yml
