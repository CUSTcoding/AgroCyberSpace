# ==============================================================================
# AgroSight Fair Space — Environment Configuration Example
# ==============================================================================
# Copy this file to .env and fill in your real credentials.
# NEVER commit the actual .env file to Git.

# --- Environment & API ---
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000"]

# --- Database Connections (PostgreSQL + PostGIS on Neon or Supabase) ---
# Format: postgresql+psycopg://user:password@host/dbname?sslmode=require
# Development Database URL (with connection pooler or direct)
DATABASE_URL=postgresql+psycopg://user:password@ep-example-pooler.region.aws.neon.tech/agrosight?sslmode=require

# Test Database URL (MUST be a completely separate database with PostGIS enabled; pytest never touches DEV)
TEST_DATABASE_URL=postgresql+psycopg://user:password@ep-example-pooler.region.aws.neon.tech/agrosight_test?sslmode=require

# Optional Direct Connection URL (recommended for Alembic DDL migrations, bypassing transaction poolers)
DATABASE_URL_DIRECT=postgresql+psycopg://user:password@ep-example.region.aws.neon.tech/agrosight?sslmode=require

# --- Authentication & Security ---
# Generate a secure secret using: openssl rand -hex 32
JWT_SECRET=replace_with_a_super_secret_key_at_least_32_chars_long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Object Storage (Rasters / COG) ---
STORAGE_BACKEND=local
STORAGE_PATH=./storage

# --- NASA Earthdata & USGS Credentials ---
EARTHDATA_TOKEN=
USGS_USERNAME=
USGS_TOKEN=
