# ==============================================================================
# AgroSight (AgroSpace) — Root Environment Configuration Example
# ==============================================================================
# Copy this file to .env and adjust the values for your local or cloud setup.
# DO NOT commit real secrets or credentials into version control.

# ------------------------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT & NETWORKING
# ------------------------------------------------------------------------------
ENVIRONMENT=development
BACKEND_PORT=8000
FRONTEND_PORT=3000
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ------------------------------------------------------------------------------
# 2. FRONTEND CLIENT CONFIGURATION
# ------------------------------------------------------------------------------
# In development, the Vite dev server can proxy /api directly or target this URL
VITE_API_URL=http://localhost:8000/api/v1
VITE_PORT=3000

# ------------------------------------------------------------------------------
# 3. DATABASE CONFIGURATION (PostgreSQL + PostGIS)
# ------------------------------------------------------------------------------
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<dbname>?sslmode=require
# Cloud Database (e.g. Neon, Supabase) with connection pooler or direct
DATABASE_URL=postgresql+psycopg://user:password@ep-example-pooler.region.aws.neon.tech/agrosight?sslmode=require

# Dedicated Test Database (Isolated database for pytest; PostGIS extension required)
TEST_DATABASE_URL=postgresql+psycopg://user:password@ep-example-pooler.region.aws.neon.tech/agrosight_test?sslmode=require

# Direct URL for running Alembic DDL migrations (bypasses transaction pooler if needed)
DATABASE_URL_DIRECT=postgresql+psycopg://user:password@ep-example.region.aws.neon.tech/agrosight?sslmode=require

# ------------------------------------------------------------------------------
# 4. AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
# Generate a secure 32+ character key using: openssl rand -hex 32
JWT_SECRET=replace_with_a_super_secret_key_at_least_32_chars_long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ------------------------------------------------------------------------------
# 5. STORAGE & EARTH OBSERVATION DATA
# ------------------------------------------------------------------------------
STORAGE_BACKEND=local
STORAGE_PATH=./storage

# Optional credentials for NASA Earthdata and USGS EarthExplorer ingestion
EARTHDATA_TOKEN=
USGS_USERNAME=
USGS_TOKEN=
